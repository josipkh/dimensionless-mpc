      <P Name="FixptAsFi">off</P>
      <P Name="NumInputs">1</P>
      <P Name="SampleTime">0</P>
    </Block>
    <Block BlockType="TransferFcn">
      <P Name="Numerator">[1]</P>
      <P Name="Denominator">[1 2 1]</P>
      <P Name="ParameterTunability">Auto</P>
      <P Name="AbsoluteTolerance">auto</P>
