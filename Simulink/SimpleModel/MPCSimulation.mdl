<?xml version="1.0" encoding="utf-8"?>
<chart id="28">
  <P Name="name">Succesive linearization</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">28</P>
  <P Name="ssIdHighWaterMark">12</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">Ts</P>
  <P Name="chartFileNumber">3</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">28</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [xihats,As,Bs] = fcn(Xi,oldXis,oldUs,deltaf,MPCData)
N = MPCData.N;
M = MPCData.M;
nx = MPCData.nx;
nu = MPCData.nu;

Mxi = MPCData.Mxi;
Mxinv = MPCData.Mxinv;
Mu = MPCData.Mu;
that = MPCData.that;
Ts = MPCData.Ts;
Tsp = MPCData.Tsp;

xihats = nan(nx,N+1);
As = nan(nx,nx*N);
Bs = nan(nx,nu*N);
xihat = Xi;
xihats(:,1) = Mxinv * Xi;
for j = 1:N
    if j &gt; M
        [~,xihat] = ode45(@OdeTwoTrackModel,[0,Ts],[xihat;oldUs(:,M);deltaf]);
        [A,B] = TwoTrackModelJacobian(oldXis(:,j),oldUs(:,M),deltaf);
    else
        [~,xihat] = ode45(@OdeTwoTrackModel,[0,Ts],[xihat;oldUs(:,j);deltaf]);
        [A,B] = TwoTrackModelJacobian(oldXis(:,j),oldUs(:,j),deltaf);
    end
    xihat = xihat(end,1:8)&apos;;  % nx*(N+1)
    % transform to Pi-space
    xihats(:,j+1) = Mxinv * xihat;

    % formulate in Pi-space and discretize (from c2d.m)
    Ap = that * Mxinv * A * Mxi;
    Bp = that * Mxinv * B * Mu;
    [~,n] = size(Ap);
    [~,nb] = size(Bp);
    s = expm([[Ap Bp]*Ts; zeros(nb,n+nb)]);
    Ad = s(1:n,1:n);
    Bd= s(1:n,n+1:n+nb);
    
    As(:,nx*(j-1)+1:nx*j) = Ad;
    Bs(:,nu*(j-1)+1:nu*j) = Bd;       
end</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="Xi">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
